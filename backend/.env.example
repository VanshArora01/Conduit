JWT_REFRESH_SECRET_KEY=change-me-to-another-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

##############################################
