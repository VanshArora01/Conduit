# =============================================================================
# Conduit — production .gitignore
# =============================================================================

# ---- Secrets & local env (NEVER commit) ----
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
credentials.json
service-account*.json
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.log
app.log

# ---- Node / Next.js ----
node_modules/
.npm/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---- Runtime data (local only) ----
backend/storage/
backend/logs/
backend/debug/
backend/error_trace.txt
backend/register.json
backend/test.json
storage/
logs/
tmp/
temp/
*.sqlite
*.db

# ---- Docker / local overrides ----
.docker/
docker-compose.override.yml

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ---- Misc ----
*.tmp
.cache/
coverage/
