# Public API URL for the Next.js app.
# In development, Next.js rewrites /api/v1 → BACKEND_URL (see next.config.ts),
# so the browser uses same-origin /api/v1 by default.
NEXT_PUBLIC_API_URL=/api/v1

# Optional: backend origin used by Next.js rewrites (server-side only)
# BACKEND_URL=http://127.0.0.1:8000
